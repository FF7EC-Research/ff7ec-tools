<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No storage permission needed: logs go to the game's own
         getExternalFilesDir() (see README.md "Finding the logs"), which
         is always exempt from scoped storage. -->

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <!-- Standard LSPosed/Xposed module declaration. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <!-- Scopes this module to exactly the one app in LSPosed's manager
             UI, so it isn't offered (and doesn't need to be enabled) for
             every installed app. -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>
</manifest>
