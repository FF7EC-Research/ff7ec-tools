<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to write into /sdcard/ff7ec-logs (shared storage, not this
         module's own app-private dir) on Android 10 and below; on 11+ the
         hooked app (FF7EC) needs MANAGE_EXTERNAL_STORAGE granted instead,
         since the write happens inside its process/UID, not this one's -
         see README.md "Storage permission" for exactly what to grant and
         why declaring it here alone isn't sufficient. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <!-- Standard LSPosed/Xposed module declaration. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <!-- Scopes this module to exactly the one app in LSPosed's manager
             UI, so it isn't offered (and doesn't need to be enabled) for
             every installed app. -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>
</manifest>
